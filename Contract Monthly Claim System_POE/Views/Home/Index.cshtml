@{
    ViewBag.Title = "Home Page";
}

<!-- Home page container with background color and padding -->
<div class="container-fluid bg-light text-center py-5" style="min-height: 100vh;">
    <div class="container">
        <!-- Welcome Message with animation -->
        <div class="row mb-5">
            <div class="col">
                <h1 class="display-4 text-primary">Welcome to the Contract Monthly Claim System</h1>
            </div>
        </div>

        <!-- Button section -->
        <div class="row justify-content-center">
            <div class="col-md-3 mb-3">
                <a href="/Claims/ListClaims" class="btn btn-lg btn-secondary btn-block shadow-sm">View Claims</a>
            </div>
        </div>
    </div>
</div>
